# Firebase Console > Project settings > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only: same project as the web app. Never use NEXT_PUBLIC_ here.
FIREBASE_PROJECT_ID=
# Optional: credentials enable additional revocation/disabled-user checks.
FIREBASE_CLIENT_EMAIL=
# Keep the quotes. Paste the private key with literal \n line separators.
FIREBASE_PRIVATE_KEY=""
# Alternative to CLIENT_EMAIL/PRIVATE_KEY: absolute path to a service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
